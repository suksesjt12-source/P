<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Fighter 3D</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none; }
  html, body { width:100%; height:100%; overflow:hidden; background:#000; font-family: 'Impact', sans-serif; }
  #gameCanvas { display:block; width:100%; height:100%; }
  
  #hud { position:fixed; top:0; left:0; width:100%; padding:10px; display:flex; justify-content:space-between; align-items:flex-start; pointer-events:none; z-index:10; }
  .hp-container { width:40%; }
  .hp-name { color:#fff; font-size:14px; text-shadow:2px 2px 0 #000; margin-bottom:4px; }
  .hp-bar { width:100%; height:18px; background:#333; border:2px solid #fff; border-radius:4px; overflow:hidden; }
  .hp-fill { height:100%; background:linear-gradient(90deg,#ff0040,#ff8800); transition:width 0.3s; }
  .hp-fill.p2 { background:linear-gradient(90deg,#00ccff,#0066ff); float:right; }
  
  #timer { position:fixed; top:10px; left:50%; transform:translateX(-50%); color:#ffdd00; font-size:32px; text-shadow:3px 3px 0 #000; z-index:10; }
  
  #controls { position:fixed; bottom:0; left:0; width:100%; height:40%; pointer-events:none; z-index:20; }
  .joystick-base { position:absolute; bottom:30px; left:30px; width:120px; height:120px; background:rgba(255,255,255,0.15); border:3px solid rgba(255,255,255,0.4); border-radius:50%; pointer-events:auto; }
  .joystick-stick { position:absolute; top:30px; left:30px; width:60px; height:60px; background:rgba(255,255,255,0.5); border-radius:50%; transition:transform 0.05s; }
  
  .btn { position:absolute; width:70px; height:70px; border-radius:50%; border:3px solid #fff; color:#fff; font-size:14px; font-weight:bold; display:flex; align-items:center; justify-content:center; pointer-events:auto; text-shadow:1px 1px 2px #000; }
  .btn-punch { bottom:80px; right:30px; background:rgba(255,60,60,0.5); }
  .btn-kick { bottom:30px; right:110px; background:rgba(60,120,255,0.5); }
  .btn-block { bottom:30px; right:20px; background:rgba(60,255,60,0.5); }
  .btn-special { bottom:150px; right:100px; background:rgba(255,200,0,0.5); font-size:11px; }
  .btn:active { transform:scale(0.9); filter:brightness(1.5); }
  
  #message { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); color:#fff; font-size:60px; text-shadow:4px 4px 0 #000, -2px -2px 0 #000; z-index:30; display:none; text-align:center; letter-spacing:4px; }
  #startScreen { position:fixed; inset:0; background:radial-gradient(circle, #220033, #000); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:100; color:#fff; }
  #startScreen h1 { font-size:48px; color:#ffdd00; text-shadow:4px 4px 0 #ff0040; letter-spacing:6px; margin-bottom:20px; }
  #startScreen p { font-size:16px; margin-bottom:30px; opacity:0.8; }
  #startBtn { padding:15px 40px; font-size:24px; background:#ff0040; color:#fff; border:3px solid #fff; border-radius:10px; font-family:inherit; letter-spacing:3px; }
  #startBtn:active { background:#ffdd00; color:#000; }
</style>
</head>
<body>

<div id="startScreen">
  <h1>FIGHTER 3D</h1>
  <p>Shadow vs Blaze — Round 1</p>
  <button id="startBtn">FIGHT!</button>
</div>

<div id="hud">
  <div class="hp-container">
    <div class="hp-name">SHADOW</div>
    <div class="hp-bar"><div class="hp-fill" id="hp1" style="width:100%"></div></div>
  </div>
  <div class="hp-container" style="text-align:right">
    <div class="hp-name">BLAZE</div>
    <div class="hp-bar"><div class="hp-fill p2" id="hp2" style="width:100%"></div></div>
  </div>
</div>

<div id="timer">99</div>

<div id="controls">
  <div class="joystick-base" id="joyBase">
    <div class="joystick-stick" id="joyStick"></div>
  </div>
  <div class="btn btn-special" id="btnSpecial">ULTI</div>
  <div class="btn btn-punch" id="btnPunch">PUNCH</div>
  <div class="btn btn-kick" id="btnKick">KICK</div>
  <div class="btn btn-block" id="btnBlock">BLOCK</div>
</div>

<div id="message"></div>

<script src="https://cdn.jsdelivr.net/npm/three@0.155.0/build/three.min.js"></script>
<script>
// ============ SCENE SETUP ============
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x1a0033);
scene.fog = new THREE.Fog(0x1a0033, 15, 40);

const camera = new THREE.PerspectiveCamera(60, innerWidth/innerHeight, 0.1, 100);
camera.position.set(0, 2.5, 7);
camera.lookAt(0, 1, 0);

const renderer = new THREE.WebGLRenderer({ antialias:true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.body.appendChild(renderer.domElement);

// Lights
const ambient = new THREE.AmbientLight(0x6666aa, 0.6);
scene.add(ambient);
const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
dirLight.position.set(5, 10, 5);
dirLight.castShadow = true;
dirLight.shadow.mapSize.set(1024, 1024);
dirLight.shadow.camera.left = -10; dirLight.shadow.camera.right = 10;
dirLight.shadow.camera.top = 10; dirLight.shadow.camera.bottom = -10;
scene.add(dirLight);

const spotRed = new THREE.PointLight(0xff0044, 2, 15);
spotRed.position.set(-5, 4, 2);
scene.add(spotRed);
const spotBlue = new THREE.PointLight(0x0088ff, 2, 15);
spotBlue.position.set(5, 4, 2);
scene.add(spotBlue);

// ============ ARENA ============
const floorGeo = new THREE.PlaneGeometry(30, 20);
const floorMat = new THREE.MeshStandardMaterial({ 
  color:0x222244, roughness:0.3, metalness:0.6 
});
const floor = new THREE.Mesh(floorGeo, floorMat);
floor.rotation.x = -Math.PI/2;
floor.receiveShadow = true;
scene.add(floor);

// Grid lines
const gridHelper = new THREE.GridHelper(30, 30, 0x4444ff, 0x222266);
scene.add(gridHelper);

// Pillars
for (let i = -2; i <= 2; i++) {
  const pillar = new THREE.Mesh(
    new THREE.CylinderGeometry(0.3, 0.3, 4, 8),
    new THREE.MeshStandardMaterial({ color:0x555577, metalness:0.8, roughness:0.2 })
  );
  pillar.position.set(i*4, 2, -8);
  pillar.castShadow = true;
  scene.add(pillar);
}

// ============ FIGHTER CLASS ============
class Fighter {
  constructor(color, x, isPlayer) {
    this.group = new THREE.Group();
    this.isPlayer = isPlayer;
    this.hp = 100;
    this.maxHp = 100;
    this.vx = 0; this.vy = 0;
    this.state = 'idle'; // idle, walk, punch, kick, block, hit, special
    this.stateTime = 0;
    this.facing = isPlayer ? 1 : -1;
    this.attackCooldown = 0;
    this.hitCooldown = 0;
    this.specialCharge = 0;
    
    // Body parts
    const mat = new THREE.MeshStandardMaterial({ color, roughness:0.4, metalness:0.3 });
    const matDark = new THREE.MeshStandardMaterial({ color:0x222222, roughness:0.5 });
    const matSkin = new THREE.MeshStandardMaterial({ color:0xffcc99, roughness:0.7 });
    
    // Torso
    this.torso = new THREE.Mesh(new THREE.BoxGeometry(0.8, 1, 0.5), mat);
    this.torso.position.y = 1.2;
    this.torso.castShadow = true;
    this.group.add(this.torso);
    
    // Head
    this.head = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.5, 0.5), matSkin);
    this.head.position.y = 2;
    this.head.castShadow = true;
    this.group.add(this.head);
    
    // Eyes
    const eyeMat = new THREE.MeshBasicMaterial({ color: isPlayer ? 0x00ffff : 0xff0000 });
    const eye1 = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.08, 0.05), eyeMat);
    eye1.position.set(-0.12, 2.05, 0.26);
    this.group.add(eye1);
    const eye2 = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.08, 0.05), eyeMat);
    eye2.position.set(0.12, 2.05, 0.26);
    this.group.add(eye2);
    
    // Arms
    this.armL = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.8, 0.25), mat);
    this.armL.position.set(-0.55, 1.3, 0);
    this.armL.geometry.translate(0, 0.4, 0);
    this.armL.castShadow = true;
    this.group.add(this.armL);
    
    this.armR = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.8, 0.25), mat);
    this.armR.position.set(0.55, 1.3, 0);
    this.armR.geometry.translate(0, 0.4, 0);
    this.armR.castShadow = true;
    this.group.add(this.armR);
    
    // Fists
    this.fistL = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.3, 0.3), matSkin);
    this.fistL.position.set(-0.55, 2.1, 0);
    this.group.add(this.fistL);
    this.fistR = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.3, 0.3), matSkin);
    this.fistR.position.set(0.55, 2.1, 0);
    this.group.add(this.fistR);
    
    // Legs
    this.legL = new THREE.Mesh(new THREE.BoxGeometry(0.3, 1, 0.3), matDark);
    this.legL.position.set(-0.2, 0.5, 0);
    this.legL.geometry.translate(0, 0.5, 0);
    this.legL.castShadow = true;
    this.group.add(this.legL);
    
    this.legR = new THREE.Mesh(new THREE.BoxGeometry(0.3, 1, 0.3), matDark);
    this.legR.position.set(0.2, 0.5, 0);
    this.legR.geometry.translate(0, 0.5, 0);
    this.legR.castShadow = true;
    this.group.add(this.legR);
    
    this.group.position.set(x, 0, 0);
    scene.add(this.group);
  }
  
  setState(s) {
    if (this.state === s) return;
    this.state = s;
    this.stateTime = 0;
  }
  
  takeDamage(amount) {
    if (this.hitCooldown > 0) return;
    if (this.state === 'block') amount *= 0.2;
    this.hp = Math.max(0, this.hp - amount);
    this.hitCooldown = 0.4;
    if (this.state !== 'block') this.setState('hit');
    // Knockback
    this.vx = -this.facing * 0.15;
    this.vy = 0.1;
    updateHP();
    if (this.hp <= 0) endRound(this.isPlayer ? 'BLAZE' : 'SHADOW');
  }
  
  update(dt, opponent) {
    this.stateTime += dt;
    this.attackCooldown = Math.max(0, this.attackCooldown - dt);
    this.hitCooldown = Math.max(0, this.hitCooldown - dt);
    
    // Face opponent
    if (opponent) {
      this.facing = opponent.group.position.x > this.group.position.x ? 1 : -1;
      this.group.rotation.y = this.facing > 0 ? 0 : Math.PI;
    }
    
    // Physics
    this.group.position.x += this.vx;
    this.group.position.y += this.vy;
    this.vy -= 0.02;
    if (this.group.position.y < 0) { this.group.position.y = 0; this.vy = 0; }
    this.vx *= 0.85;
    
    // Boundaries
    this.group.position.x = Math.max(-6, Math.min(6, this.group.position.x));
    
    // Animation per state
    const t = this.stateTime;
    switch(this.state) {
      case 'idle':
        this.torso.position.y = 1.2 + Math.sin(t*3)*0.03;
        this.armL.rotation.x = Math.sin(t*2)*0.1;
        this.armR.rotation.x = -Math.sin(t*2)*0.1;
        this.fistL.position.y = 2.1 + Math.sin(t*2)*0.05;
        this.fistR.position.y = 2.1 - Math.sin(t*2)*0.05;
        this.fistL.position.z = 0.1; this.fistR.position.z = 0.1;
        this.legL.rotation.x = 0; this.legR.rotation.x = 0;
        break;
      case 'walk':
        this.legL.rotation.x = Math.sin(t*10)*0.6;
        this.legR.rotation.x = -Math.sin(t*10)*0.6;
        this.armL.rotation.x = -Math.sin(t*10)*0.4;
        this.armR.rotation.x = Math.sin(t*10)*0.4;
        this.fistL.position.z = 0.1; this.fistR.position.z = 0.1;
        this.fistL.position.y = 2.1; this.fistR.position.y = 2.1;
        break;
      case 'punch':
        const p = Math.min(1, t/0.15);
        this.armR.rotation.x = -Math.PI/2 * p;
        this.fistR.position.z = 0.1 + p*0.8;
        this.fistR.position.y = 2.1 - p*0.3;
        if (t > 0.15 && t < 0.25 && opponent) this.checkHit(opponent, 0.8, 1.2);
        if (t > 0.4) this.setState('idle');
        break;
      case 'kick':
        const k = Math.min(1, t/0.2);
        this.legR.rotation.x = -Math.PI/2.5 * k;
        if (t > 0.2 && t < 0.3 && opponent) this.checkHit(opponent, 1.2, 0.8);
        if (t > 0.5) this.setState('idle');
        break;
      case 'block':
        this.armL.rotation.x = -Math.PI/2;
        this.armR.rotation.x = -Math.PI/2;
        this.fistL.position.z = 0.4; this.fistR.position.z = 0.4;
        this.fistL.position.y = 1.8; this.fistR.position.y = 1.8;
        break;
      case 'hit':
        this.torso.rotation.z = Math.sin(t*20)*0.1;
        if (t > 0.3) { this.setState('idle'); this.torso.rotation.z = 0; }
        break;
      case 'special':
        const s = Math.min(1, t/0.3);
        this.armL.rotation.x = -Math.PI*s;
        this.armR.rotation.x = -Math.PI*s;
        this.fistL.position.z = 0.1 + s*1.2;
        this.fistR.position.z = 0.1 + s*1.2;
        this.fistL.position.y = 2.1; this.fistR.position.y = 2.1;
        this.group.position.y = Math.sin(s*Math.PI)*0.3;
        if (t > 0.3 && t < 0.4 && opponent) this.checkHit(opponent, 2.5, 1.5);
        if (t > 0.6) this.setState('idle');
        break;
    }
  }
  
  checkHit(opp, damage, range) {
    const dist = Math.abs(this.group.position.x - opp.group.position.x);
    if (dist < range && this.attackCooldown <= 0) {
      opp.takeDamage(damage);
      this.attackCooldown = 0.3;
      spawnHitEffect(opp.group.position.x, 1.5, opp.group.position.z);
    }
  }
  
  move(dx) {
    if (this.state === 'hit' || this.state === 'punch' || this.state === 'kick' || this.state === 'special') return;
    this.group.position.x += dx;
    if (Math.abs(dx) > 0.01 && this.state !== 'walk' && this.state !== 'block') this.setState('walk');
    else if (Math.abs(dx) < 0.01 && this.state === 'walk') this.setState('idle');
  }
}

// ============ HIT EFFECTS ============
const effects = [];
function spawnHitEffect(x, y, z) {
  const geo = new THREE.SphereGeometry(0.3, 8, 8);
  const mat = new THREE.MeshBasicMaterial({ color:0xffff00, transparent:true, opacity:1 });
  const m = new THREE.Mesh(geo, mat);
  m.position.set(x, y, z);
  m.userData = { life:0.3 };
  scene.add(m);
  effects.push(m);
}

// ============ GAME STATE ============
let player, enemy, gameRunning = false, timeLeft = 99;

function initGame() {
  player = new Fighter(0x3344aa, -2, true);   // Shadow (blue)
  enemy = new Fighter(0xaa2233, 2, false);    // Blaze (red)
  timeLeft = 99;
  gameRunning = true;
  updateHP();
}

function updateHP() {
  document.getElementById('hp1').style.width = player.hp + '%';
  document.getElementById('hp2').style.width = enemy.hp + '%';
}

function showMessage(text, color='#ffdd00') {
  const m = document.getElementById('message');
  m.textContent = text;
  m.style.color = color;
  m.style.display = 'block';
  setTimeout(() => m.style.display = 'none', 2000);
}

function endRound(winner) {
  gameRunning = false;
  showMessage(winner + ' WINS!', winner === 'SHADOW' ? '#00ffff' : '#ff0040');
  setTimeout(() => {
    if (confirm(winner + ' wins! Main lagi?')) {
      scene.remove(player.group); scene.remove(enemy.group);
      initGame();
    }
  }, 2500);
}

// ============ INPUT ============
const input = { x:0, punch:false, kick:false, block:false, special:false };

// Joystick
const joyBase = document.getElementById('joyBase');
const joyStick = document.getElementById('joyStick');
let joyActive = false, joyCenter = {x:0,y:0};

function joyStart(e) {
  const t = e.touches ? e.touches[0] : e;
  const r = joyBase.getBoundingClientRect();
  joyCenter = { x:r.left + r.width/2, y:r.top + r.height/2 };
  joyActive = true;
  joyMove(e);
}
function joyMove(e) {
  if (!joyActive) return;
  const t = e.touches ? e.touches[0] : e;
  let dx = t.clientX - joyCenter.x;
  let dy = t.clientY - joyCenter.y;
  const dist = Math.hypot(dx, dy);
  const max = 40;
  if (dist > max) { dx = dx/dist*max; dy = dy/dist*max; }
  joyStick.style.transform = `translate(${dx}px, ${dy}px)`;
  input.x = dx / max;
}
function joyEnd() {
  joyActive = false;
  joyStick.style.transform = 'translate(0,0)';
  input.x = 0;
}
joyBase.addEventListener('touchstart', joyStart);
joyBase.addEventListener('touchmove', joyMove);
joyBase.addEventListener('touchend', joyEnd);
joyBase.addEventListener('mousedown', joyStart);
window.addEventListener('mousemove', joyMove);
window.addEventListener('mouseup', joyEnd);

// Buttons
function bindBtn(id, key) {
  const el = document.getElementById(id);
  const on = () => input[key] = true;
  const off = () => input[key] = false;
  el.addEventListener('touchstart', e => { e.preventDefault(); on(); });
  el.addEventListener('touchend', e => { e.preventDefault(); off(); });
  el.addEventListener('mousedown', on);
  el.addEventListener('mouseup', off);
  el.addEventListener('mouseleave', off);
}
bindBtn('btnPunch', 'punch');
bindBtn('btnKick', 'kick');
bindBtn('btnBlock', 'block');
bindBtn('btnSpecial', 'special');

// Keyboard (for desktop testing)
const keys = {};
addEventListener('keydown', e => {
  keys[e.key.toLowerCase()] = true;
  if (e.key === 'j') input.punch = true;
  if (e.key === 'k') input.kick = true;
  if (e.key === 'l') input.block = true;
  if (e.key === 'u') input.special = true;
});
addEventListener('keyup', e => {
  keys[e.key.toLowerCase()] = false;
  if (e.key === 'j') input.punch = false;
  if (e.key === 'k') input.kick = false;
  if (e.key === 'l') input.block = false;
  if (e.key === 'u') input.special = false;
});

// ============ AI ============
function updateAI(dt) {
  if (!gameRunning || !enemy || enemy.state === 'hit') return;
  const dist = Math.abs(player.group.position.x - enemy.group.position.x);
  const dir = player.group.position.x > enemy.group.position.x ? 1 : -1;
  
  if (dist > 1.5) {
    enemy.move(dir * 0.04);
  } else {
    // Attack decision
    if (enemy.attackCooldown <= 0 && Math.random() < 0.03) {
      const r = Math.random();
      if (r < 0.5) enemy.setState('punch');
      else if (r < 0.85) enemy.setState('kick');
      else if (enemy.specialCharge >= 100) { enemy.setState('special'); enemy.specialCharge = 0; }
    }
    // Block sometimes
    if (player.state === 'punch' || player.state === 'kick') {
      if (Math.random() < 0.02) enemy.setState('block');
    } else if (enemy.state === 'block' && Math.random() < 0.05) {
      enemy.setState('idle');
    }
  }
  enemy.specialCharge = Math.min(100, enemy.specialCharge + dt*5);
}

// ============ MAIN LOOP ============
let lastTime = performance.now();
let timerAcc = 0;

function loop() {
  const now = performance.now();
  const dt = Math.min(0.05, (now - lastTime)/1000);
  lastTime = now;
  
  if (gameRunning) {
    // Player input
    if (player.state !== 'hit') {
      player.move(input.x * 0.08);
      if (keys['a']) player.move(-0.08);
      if (keys['d']) player.move(0.08);
      
      if (input.punch && player.attackCooldown <= 0) { player.setState('punch'); input.punch = false; }
      else if (input.kick && player.attackCooldown <= 0) { player.setState('kick'); input.kick = false; }
      else if (input.block) player.setState('block');
      else if (input.special && player.specialCharge >= 100) { player.setState('special'); player.specialCharge = 0; input.special = false; }
      else if (!input.block && (player.state === 'block' || player.state === 'idle' || player.state === 'walk')) {
        if (Math.abs(input.x) < 0.1 && !keys['a'] && !keys['d'] && player.state === 'walk') player.setState('idle');
      }
      
      player.specialCharge = Math.min(100, player.specialCharge + dt*8);
    }
    
    updateAI(dt);
    player.update(dt, enemy);
    enemy.update(dt, player);
    
    // Camera follow
    const midX = (player.group.position.x + enemy.group.position.x)/2;
    const dist = Math.abs(player.group.position.x - enemy.group.position.x);
    camera.position.x += (midX - camera.position.x) * 0.1;
    camera.position.z = 6 + dist*0.3;
    camera.lookAt(midX, 1.2, 0);
    
    // Timer
    timerAcc += dt;
    if (timerAcc >= 1) { timerAcc = 0; timeLeft--; document.getElementById('timer').textContent = timeLeft; }
    if (timeLeft <= 0) {
      gameRunning = false;
      endRound(player.hp >= enemy.hp ? 'SHADOW' : 'BLAZE');
    }
  }
  
  // Effects
  for (let i = effects.length-1; i >= 0; i--) {
    const e = effects[i];
    e.userData.life -= dt;
    e.scale.multiplyScalar(1.1);
    e.material.opacity = e.userData.life / 0.3;
    if (e.userData.life <= 0) { scene.remove(e); effects.splice(i,1); }
  }
  
  // Lights pulse
  s
